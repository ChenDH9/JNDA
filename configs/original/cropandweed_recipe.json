    "Fresh_S7": {
      "role": "fresh RGB-LoRA generative comparator and Arm A precursor",
      "initialization": "verified FLUX base plus seeded fresh rank-8 transformer LoRA; no task checkpoint",
      "trainable": [
        "transformer_lora"
      ],
      "old_task_checkpoints_allowed": false,
      "inference": {
        "steps": 10,
        "guidance_scale": 4.0,
        "scheduler": "FlowMatchEulerDiscreteScheduler",
        "readout": "nearest canonical palette in sRGB",
        "palette_tie_order": [
          "background/soil",
          "crop",
          "weed"
        ]
      }
    },
    "Fresh_Arm_A": {
      "role": "paired frozen-adapter native-interface arm",
      "cleanroom_lineage": "for seed s, consume only the exact final Fresh_S7 adapter trained under this experiment for seed s; freeze base and that adapter; seed a new native head and train the head",
      "paired_s7_checkpoint_is_not_historical_reuse": true,
      "independent_or_cross_seed_s7_adapter_forbidden": true,
      "trainable": [
        "native_head"
      ],
      "old_task_checkpoints_allowed": false
    },
    "Fresh_Arm_B": {
      "role": "fresh joint-native candidate",
      "initialization": "verified FLUX base plus seeded fresh rank-8 transformer LoRA and seeded fresh native head",
      "trainable": [
        "transformer_lora",
        "native_head"
      ],
      "old_task_checkpoints_allowed": false
    },
    "Fresh_SegFormer_B2": {
      "role": "fresh strong supervised comparator",
      "initialization": "verified public ADE20K checkpoint; every compatible encoder/decode tensor loaded; only classifier replaced",
      "trainable": [
        "full_segformer",
        "three_class_classifier"
      ],
      "old_task_checkpoints_allowed": false
    }
  },
